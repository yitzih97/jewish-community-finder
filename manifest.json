{
  "manifest_version": 3,
  "name": "Jewish Community Finder",
  "version": "1.0.3",
  "description": "See every shul, kosher restaurant, Jewish school, and mikvah in the map area you're browsing on Zillow, Airbnb, and other map sites.",
  "key": "",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://overpass-api.de/*",
    "https://maps.mail.ru/*",
    "https://overpass.kumi.systems/*",
    "https://nominatim.openstreetmap.org/*",
    "https://mikvah.org/*",
    "https://services1.arcgis.com/*",
    "https://server.arcgisonline.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Jewish Community Finder — show shuls, kosher food & schools in this area"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zillow.com/*",
        "https://*.airbnb.com/*",
        "https://*.airbnb.ca/*",
        "https://*.airbnb.co.uk/*",
        "https://*.trulia.com/*",
        "https://*.redfin.com/*",
        "https://*.realtor.com/*",
        "https://*.apartments.com/*",
        "https://*.streeteasy.com/*",
        "https://*.booking.com/*",
        "https://*.vrbo.com/*",
        "https://*.hotels.com/*",
        "https://www.google.com/maps/*",
        "https://www.google.com/maps*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
